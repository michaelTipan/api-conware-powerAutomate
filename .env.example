# Opcional para scripts/smoke_test_local.py:
# BASE_URL=http://127.0.0.1:8000

# Microsoft Graph (app registration)
# Token POST https://login.microsoftonline.com/{GRAPH_TENANT_ID}/oauth2/v2.0/token
# Body form (x-www-form-urlencoded), igual que Postman:
#   grant_type=client_credentials (fijo en codigo)
#   client_id=GRAPH_CLIENT_ID
#   client_secret=GRAPH_CLIENT_SECRET
#   scope=GRAPH_SCOPE
GRAPH_TENANT_ID=28c8c2be-82f0-4603-b881-41c2a08701e6
GRAPH_CLIENT_ID=bc1b8fc1-2a61-4af6-a5c9-3ebab882faa0
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Timeout por peticion HTTP a Graph (segundos). Subelo si ves "Timeout was reached".
GRAPH_HTTP_TIMEOUT_SECONDS=300
# Reintentos si SharePoint responde 423 Locked (Excel abierto / check-out). Base en segundos con backoff exponencial.
GRAPH_PUT_MAX_RETRIES=6
GRAPH_PUT_RETRY_BASE_SECONDS=3
# Nivel de logs de la app: DEBUG, INFO, WARNING
LOG_LEVEL=DEBUG

# SharePoint: solo criterios de busqueda/ruta. Los ids (site, drive) los devuelve Graph en runtime.
# GRAPH_TENANT_ID es el GUID en https://login.microsoftonline.com/{AQUI}/oauth2/v2.0/token
GRAPH_SHAREPOINT_SITE_SEARCH=PRUEBASHBICAPITALCOMWARE
# Ruta bajo el root del drive; si tiene espacios, entre comillas: "Carpeta/archivo.xlsx"
GRAPH_SHAREPOINT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/00 COMWARE - CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx
# Opcional: nombre de la biblioteca (ej: Documentos). Si vacio, primer drive de la lista.
GRAPH_SHAREPOINT_DRIVE_NAME=Documentos

# Base donde están las carpetas de clientes (Concepto) y créditos
GRAPH_CLIENTS_BASE_PATH=INFORMACION CREDITOS-CLIENTES/01 COMWARE AUTOMATIZACION - INFORMACION CREDITOS CLIENTES
# POST /graph/sharepoint/ensure-asientos-contables-folders (202 + job_id) — subcarpetas por crédito (defecto ASIENTOS CONTABLES + EXTRACTOS); GET .../jobs/{job_id}
GRAPH_ASIENTOS_CONTABLES_FOLDER_NAME=ASIENTOS CONTABLES
GRAPH_EXTRACTOS_FOLDER_NAME=EXTRACTOS
# Opcional: lista separada por comas (sustituye a las dos variables anteriores). Ej: ASIENTOS CONTABLES,EXTRACTOS,OTRA
# GRAPH_CREDIT_SUBFOLDERS_TO_ENSURE=

# Texto clave para identificar extractos (nombre del PDF). La fecha se toma de YYYY-MM-DD o YYYY-MM en el nombre.
GRAPH_EXTRACT_KEYWORD=Extracto
# Tolerancia al elegir combinacion de carpetas de credito frente al Crédito (subset). Validado SI = Crédito >= suma TOTAL A PAGAR de esa combinacion.
GRAPH_CREDIT_MATCH_TOLERANCE=0.02
# Fecha ancla: entre todas las carpetas del cliente se comparan la fecha de extracto más cercana hacia atrás y hacia adelante del día de pago; con la ancla se filtran PDFs y se busca qué combinación de créditos suma el Crédito del reporte.


# Payment validation workflow
GRAPH_BANK_PAYMENTS_FILE_PATH=INFORMACION CREDITOS-CLIENTES/00 COMWARE - CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx

GRAPH_PAYMENT_VALIDATION_BASE_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS
GRAPH_PAYMENT_VALIDATION_CONTROL_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL
GRAPH_PAYMENT_VALIDATION_REVIEW_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/01 REVISION
GRAPH_PAYMENT_VALIDATION_HISTORY_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/02 HISTORICO
GRAPH_PAYMENT_VALIDATION_ERRORS_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/03 ERRORES
GRAPH_PAYMENT_VALIDATION_LOGS_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/04 LOGS

# Bandejas operativas internas (minúsculas, solo API escribe): POST .../setup/payment-followup-workbooks
GRAPH_FOLLOWUP_PAGOS_ADELANTADOS_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL/pagos_adelantados.xlsx
GRAPH_FOLLOWUP_PAGOS_INCOMPLETOS_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL/pagos_incompletos.xlsx
# IBR diario (MAYÚSCULAS, secretaría edita filas de datos): POST .../setup/ibr-workbook
GRAPH_IBR_DIARIO_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL/IBR_DIARIO.xlsx
# Control de proceso (oficial por banco): POST .../setup/merge-control-workbook
# Oficiales:
# - control_proceso_validacion_pagos_banco_bogota.xlsx
# - control_proceso_validacion_pagos_banco_bancolombia.xlsx
#
# Legacy/obsoleto:
# - control_merge_pdfs.xlsx (setup ya NO lo crea ni lo repara; endpoints antiguos pueden seguir usándolo hasta migración)
GRAPH_MERGE_CONTROL_WORKBOOK_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL/control_merge_pdfs.xlsx

# Optional defaults for generated files
GRAPH_VALIDATION_FILE_PREFIX=validacion_pagos
GRAPH_VALIDATED_HISTORY_FILE_PREFIX=cartera_validada

# Correo: extractos a validar (POST /graph/sharepoint/notify-validar-extractos-email)
# Body JSON obligatorio: historical_file_path = misma ruta relativa al drive que result.historical_file_path de Finalize (no webUrl).
# El Excel histórico no se busca por carpetas: solo se descarga esa ruta. Requiere Mail.Send y lectura de Excel/PDF en el drive.
# Remitente (EMISOR, primer correo) y destinatarios (RECEPTORES) se leen de CORREOS.xlsx — no de GRAPH_MAIL_SENDER_EMAIL / GRAPH_VALIDAR_NOTIFY_TO.
GRAPH_VALIDAR_NOTIFY_CORREOS_XLSX_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/00 CONTROL/CORREOS.xlsx
# Otras rutas que aún usan buzón fijo (p. ej. otros correos):
GRAPH_MAIL_SENDER_EMAIL=ia@comware.com.ec
GRAPH_VALIDAR_NOTIFY_TO=josue.tipan@clearminds-it.com
GRAPH_VALIDAR_NOTIFY_CC=
GRAPH_NOTIFY_BANK_NAME=BANCO BOGOTA
# Palabra en "Estado línea": debe coincidir como token (ej. VALIDAR), no como substring de otra palabra.
GRAPH_VALIDAR_EXTRACTO_ESTADO_CONTAINS=VALIDAR
# Asunto del correo (texto fijo o variable de entorno).
GRAPH_VALIDAR_NOTIFY_EMAIL_SUBJECT=ABONOS BANCO BOGOTA
# Primer párrafo del cuerpo (HTML): placeholders {fecha} (dd/mm/yyyy del reporte) y {banco}.
GRAPH_VALIDAR_NOTIFY_BODY_INTRO_TEMPLATE=Buenos días. El día {fecha} ingresaron a la cuenta {banco} los siguientes valores, que corresponden a:
# Obsoleto: si BODY_INTRO_TEMPLATE está vacío, se usa como respaldo para el párrafo inicial del cuerpo (no para el asunto).
# GRAPH_VALIDAR_NOTIFY_SUBJECT_TEMPLATE=
# (Notify ya no resuelve histórico por fecha; Merge u otros flujos pueden seguir usando estas variables.)
# Si no se define, se usa GRAPH_PAYMENT_VALIDATION_HISTORY_PATH. Subcarpetas por fecha (coma = varios formatos a probar).
GRAPH_VALIDAR_NOTIFY_HISTORICO_PATH=
GRAPH_VALIDAR_NOTIFY_HISTORICO_DATE_FORMATS=%Y-%m-%d,%d-%m-%Y,%d%m%Y
# Nombre exacto del Excel bajo la carpeta de la fecha (opcional). Placeholders: {fecha},{iso},{y},{m},{d}
GRAPH_VALIDAR_NOTIFY_HISTORICO_EXCEL_NAME=
GRAPH_VALIDAR_NOTIFY_ATTACH_PDFS=true
GRAPH_VALIDAR_NOTIFY_EXPORT_EMAIL_PDF=true
GRAPH_VALIDAR_NOTIFY_EXPORT_EMAIL_PDF_FOLDER_PATH=INFORMACION CREDITOS-CLIENTES/02 COMWARE - VALIDACION PAGOS/05 EMAIL
# El PDF en drive es solo la vista del correo (texto + tabla); los extractos van adjuntos al mail, no fusionados al PDF.
GRAPH_VALIDAR_NOTIFY_EXPORT_EMAIL_PDF_NAME_TEMPLATE=ABONOS BANCO BOGOTA {fecha}.pdf
GRAPH_MAIL_ATTACH_MAX_BYTES=20000000
# Si el link es URL completa, opcional: prefijos a quitar (uno por línea) para obtener ruta relativa al drive.
GRAPH_LINK_EXTRACTO_URL_PREFIX_STRIP=
# Subcadena donde empieza la ruta bajo el root del drive (se toma desde ahí hasta .pdf). Ej. INFORMACION CREDITOS-CLIENTES
GRAPH_LINK_EXTRACTO_PATH_ANCHOR=INFORMACION CREDITOS-CLIENTES
# Tras /sites/{sitio}/, quitar estos segmentos de biblioteca si aparecen antes de la ruta real (coma).
GRAPH_LINK_EXTRACTO_AFTER_SITES_STRIP_LIBRARIES=Shared Documents,Documentos compartidos,Documents,Documentos